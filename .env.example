# Copie para .env e preencha. Nunca commite o .env.
# Publishable é espelhada no client via next.config (env NEXT_PUBLIC_*).
# SECRET e API_KEY_CLAUDE nunca com NEXT_PUBLIC_.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Chave Anthropic (console.anthropic.com) — padrão sk-ant-usr-
API_KEY_CLAUDE=

# Feature flag do produto (fluxo principal deve funcionar com false)
AI_ENABLED=true

# Canary do LLM (aleatório por ambiente; NÃO commitar valor real)
LLM_CANARY=

# HMAC para rate limit (não use o IP em claro nos eventos)
RATE_LIMIT_HMAC_SECRET=

# Token do painel /apresentador?token=
PRESENTER_TOKEN=
